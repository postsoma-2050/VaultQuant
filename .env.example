# =========================================================================
# VaultQuant Environment Variables (.env / .env.local)
# =========================================================================
# Copy this file to '.env' or '.env.local' in the project root,
# then replace the placeholder values below with your own keys/endpoints.
# Remember to restart the development server (npm run dev) after saving changes.

# -------------------------------------------------------------------------
# 1. Database Connection (Default: Local SQLite Database file local.db)
# -------------------------------------------------------------------------
DATABASE_URL="file:local.db"

# -------------------------------------------------------------------------
# 2. Custom AI Configuration (Supports OpenAI-compatible Endpoints or Anthropic)
# -------------------------------------------------------------------------
# Your AI Provider API Key (Required for AI Diagnosis & Report Generation)
AI_API_KEY="your_ai_api_key_here"

# Custom AI Provider Base URL / Proxy Endpoint (Optional)
# E.g., https://api.gptsapi.net, https://openrouter.ai/api/v1, etc.
AI_BASE_URL="your_ai_base_url_here"

# Custom AI Model Name (Optional, defaults to claude-3-7-sonnet-20250219)
# E.g., gpt-5.6-luna, deepseek-chat, claude-3-7-sonnet-20250219, etc.
AI_MODEL="your_ai_model_name_here"

# -------------------------------------------------------------------------
# 3. Native Anthropic SDK Fallback (Alternative when AI_BASE_URL is not set)
# -------------------------------------------------------------------------
# CLAUDE_API_KEY="your_claude_api_key_here"
